<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ sistem açılış ekranı (splash) -->
    <style name="Theme.Supfy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/supfy_bg</item>
        <item name="android:colorBackground">@color/supfy_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/supfy_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
